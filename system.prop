# A37 display and legacy USB gadget.
ro.sf.lcd_density=320
ro.opengles.version=196610
ro.sf.hwrotation=0
debug.hwui.render_dirty_regions=false
qemu.hw.mainkeys=1
persist.sys.usb.config=mtp,adb
service.adb.root=1
ro.sys.sdcardfs=true

# Use the platform implementations for virtual and USB audio devices.
ro.hardware.audio.r_submix=default
ro.hardware.audio.usb=default

# The controller rejects extended feature page 2 despite advertising it.
ro.bluetooth.max_feature_page=1

# Android 8 MediaTek modem / RIL stack.
rild.libpath=mtk-ril.so
rild.libargs=-d /dev/ttyC0
ro.telephony.sim.count=2
ro.telephony.default_network=9
persist.radio.multisim.config=dsds
ril.external.md=0
ril.telephony.mode=0
ro.mtk_sim_hot_swap=1
ro.mtk_lte_support=1
ro.mtk_rild_read_imsi=1
ro.mtk_protocol1_rat_config=Lf/Lt/W/T/G
persist.radio.mtk_ps2_rat=W/G
persist.radio.mtk_ps3_rat=G
# The loader leaves these boot options out of the command line.
ro.boot.opt_using_default=1
ro.boot.opt_md1_support=12
ro.boot.opt_md2_support=0
ro.boot.opt_md5_support=0

# Native MTK IMS plus the Oreo ImsService compatibility implementation.
ro.mtk_ims_support=1
ro.mtk_volte_support=1
persist.mtk_ims_support=1
persist.mtk_volte_support=1
persist.volte_enabled_by_hw=1

# Legacy MTK codecs access the PQ service through the system Binder.
persist.media.treble_omx=false

# Per-frame legacy camera traces can stall the preview pipeline.
log.tag.mHalFDVT=W
log.tag.MDP=W
