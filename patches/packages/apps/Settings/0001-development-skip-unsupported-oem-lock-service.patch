From b06f85817d760d3b1b57efbf19e7edf40b68255e Mon Sep 17 00:00:00 2001
From: affggh <879632264@qq.com>
Date: Sun, 22 Nov 2026 18:28:04 +0800
Subject: [PATCH] Development: Skip OEM lock lookup when unlocking is
 unsupported

Accessing a missing oem_lock service triggers a fatal WTF on eng builds. Check ro.oem_unlock_supported before looking up the service, including the preference visibility check.

Change-Id: I8d4b992b8eb680677ab808a684e565c4ab3fd088
---
 .../android/settings/development/DevelopmentSettings.java | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/com/android/settings/development/DevelopmentSettings.java b/src/com/android/settings/development/DevelopmentSettings.java
index a864867..83bf3eb 100644
--- a/src/com/android/settings/development/DevelopmentSettings.java
+++ b/src/com/android/settings/development/DevelopmentSettings.java
@@ -420,7 +420,9 @@ public class DevelopmentSettings extends RestrictedSettingsFragment
         mBackupManager = IBackupManager.Stub.asInterface(
                 ServiceManager.getService(Context.BACKUP_SERVICE));
         mWebViewUpdateService = WebViewFactory.getUpdateService();
-        mOemLockManager = (OemLockManager) getSystemService(Context.OEM_LOCK_SERVICE);
+        if (SystemProperties.getBoolean("ro.oem_unlock_supported", false)) {
+            mOemLockManager = (OemLockManager) getSystemService(Context.OEM_LOCK_SERVICE);
+        }
         mTelephonyManager = (TelephonyManager) getSystemService(Context.TELEPHONY_SERVICE);
 
         mUm = (UserManager) getSystemService(Context.USER_SERVICE);
@@ -1206,8 +1208,8 @@ public class DevelopmentSettings extends RestrictedSettingsFragment
     }
 
     private static boolean showEnableOemUnlockPreference(Context context) {
-        return context.getSystemService(Context.OEM_LOCK_SERVICE) != null &&
-                SystemProperties.getBoolean("ro.oem_unlock_supported", false);
+        return SystemProperties.getBoolean("ro.oem_unlock_supported", false)
+                && context.getSystemService(Context.OEM_LOCK_SERVICE) != null;
     }
 
     /**
