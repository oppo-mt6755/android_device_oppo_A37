From 6c029f5521b6c86ccc2ed5440181958021b76c9e Mon Sep 17 00:00:00 2001
From: affggh <879632264@qq.com>
Date: Sat, 21 Nov 2026 18:57:54 +0800
Subject: [PATCH] bluetooth: Allow limiting unsupported extended feature pages

Use an opt-in property to bound feature page requests. The legacy MTK controller advertises page 2 but rejects it with HCI status 0x30; leave unread feature bits clear.

Change-Id: Ibe8681c8b8c29f4ec0fcd9ad12c133c03044bf04
---
 device/src/controller.cc | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/device/src/controller.cc b/device/src/controller.cc
index 33b9696..fc46cf9 100644
--- a/device/src/controller.cc
+++ b/device/src/controller.cc
@@ -29,6 +29,7 @@
 #include "btcore/include/version.h"
 #include "hcimsgs.h"
 #include "osi/include/future.h"
+#include "osi/include/properties.h"
 #include "stack/include/btm_ble_api.h"
 
 const bt_event_mask_t BLE_EVENT_MASK = {
@@ -129,6 +130,15 @@ static future_t* start_up(void) {
       features_classic, MAX_FEATURES_CLASSIC_PAGE_COUNT);
 
   CHECK(page_number == 0);
+  // The legacy MTK BSP advertises page 2 but rejects it with HCI status 0x30.
+  // Limit requests on this controller; leave unread feature bits cleared.
+  const int32_t feature_page_limit = osi_property_get_int32(
+      "ro.bluetooth.max_feature_page", MAX_FEATURES_CLASSIC_PAGE_COUNT - 1);
+  const bool limit_feature_pages = feature_page_limit >= 0 &&
+      feature_page_limit < MAX_FEATURES_CLASSIC_PAGE_COUNT;
+  if (limit_feature_pages &&
+      last_features_classic_page_index > feature_page_limit)
+    last_features_classic_page_index = feature_page_limit;
   page_number++;
 
   // Inform the controller what page 0 features we support, based on what
@@ -168,6 +178,10 @@ static future_t* start_up(void) {
         response, &page_number, &last_features_classic_page_index,
         features_classic, MAX_FEATURES_CLASSIC_PAGE_COUNT);
 
+    if (limit_feature_pages &&
+        last_features_classic_page_index > feature_page_limit)
+      last_features_classic_page_index = feature_page_limit;
+
     page_number++;
   }
 
-- 
2.43.0

