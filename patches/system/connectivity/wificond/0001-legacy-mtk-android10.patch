+TEST_F(ScanUtilsTest, ReconstructsLocalTimestampFromBssAge) {
+  constexpr uint32_t kAgeMs = 2000;
+  NL80211NestedAttr bss(NL80211_ATTR_BSS);
+  bss.AddAttribute(NL80211Attr<uint32_t>(NL80211_BSS_SEEN_MS_AGO, kAgeMs));
+  // An AP clock must not override the observation's local clock.
+  bss.AddAttribute(NL80211Attr<uint64_t>(NL80211_BSS_TSF, UINT64_MAX));
+  struct timespec before, after;
+  ASSERT_EQ(0, clock_gettime(CLOCK_BOOTTIME, &before));
+  uint64_t timestamp;
+  ASSERT_TRUE(scan_utils_.GetBssTimestampForTesting(bss, &timestamp));
+  ASSERT_EQ(0, clock_gettime(CLOCK_BOOTTIME, &after));
+  const uint64_t beforeUs = static_cast<uint64_t>(before.tv_sec) * 1000000 +
+                            before.tv_nsec / 1000;
+  const uint64_t afterUs = static_cast<uint64_t>(after.tv_sec) * 1000000 +
+                           after.tv_nsec / 1000;
+  EXPECT_GE(timestamp + kAgeMs * 1000, beforeUs);
+  EXPECT_LE(timestamp + kAgeMs * 1000, afterUs);
+}
+
+TEST_F(ScanUtilsTest, ClampsBssAgeBeforeBoot) {
+  NL80211NestedAttr bss(NL80211_ATTR_BSS);
+  bss.AddAttribute(NL80211Attr<uint32_t>(NL80211_BSS_SEEN_MS_AGO, UINT32_MAX));
+  uint64_t timestamp;
+  ASSERT_TRUE(scan_utils_.GetBssTimestampForTesting(bss, &timestamp));
+  EXPECT_EQ(0u, timestamp);
+}
