diff --git a/adb/Android.mk b/adb/Android.mk
index ece0645..b62d8f2 100644
--- a/adb/Android.mk
+++ b/adb/Android.mk
@@ -112,6 +112,9 @@ LOCAL_CLANG := true
 LOCAL_MODULE := libadbd_usb
 LOCAL_CFLAGS := $(LIBADB_CFLAGS) -DADB_HOST=0
 LOCAL_SRC_FILES := daemon/usb.cpp
+ifeq ($(TARGET_USES_LEGACY_ADB_INTERFACE),true)
+LOCAL_CFLAGS += -DLEGACY_ADB_INTERFACE
+endif
 
 LOCAL_SANITIZE := $(adb_target_sanitize)
 
@@ -358,6 +361,9 @@ LOCAL_CFLAGS += -DALLOW_ADBD_ROOT=1
 endif
 
 LOCAL_MODULE := adbd
+ifeq ($(TARGET_USES_LEGACY_ADB_INTERFACE),true)
+LOCAL_CFLAGS += -DLEGACY_ADB_INTERFACE
+endif
 
 LOCAL_FORCE_STATIC_EXECUTABLE := true
 
diff --git a/adb/daemon/main.cpp b/adb/daemon/main.cpp
index c510535..0b0724e 100644
--- a/adb/daemon/main.cpp
+++ b/adb/daemon/main.cpp
@@ -177,7 +177,11 @@ int adbd_main(int server_port) {
     drop_privileges(server_port);
 
     bool is_usb = false;
+#ifdef LEGACY_ADB_INTERFACE
+    if (access("/dev/android_adb", F_OK) == 0) {
+#else
     if (access(USB_FFS_ADB_EP0, F_OK) == 0) {
