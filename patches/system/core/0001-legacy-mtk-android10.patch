diff --git a/adb/daemon/usb_legacy.cpp b/adb/daemon/usb_legacy.cpp
index fe80e7d..8a8abb9 100644
--- a/adb/daemon/usb_legacy.cpp
+++ b/adb/daemon/usb_legacy.cpp
@@ -296,11 +296,67 @@ usb_handle* create_usb_handle(unsigned num_bufs, unsigned io_size) {
     return h;
 }
 
+// Character-device transport used by pre-FunctionFS Android USB gadgets.
+static int usb_character_read(usb_handle* h, void* data, int len, bool allow_partial) {
+    const int original = len;
+    char* cursor = static_cast<char*>(data);
+    while (len > 0) {
+        const int chunk = std::min(len, 4096);
+        const int count = adb_read(h->bulk_out.get(), cursor, chunk);
+        if (count <= 0 || h->kicked) return -1;
+        cursor += count;
+        len -= count;
+        if (allow_partial && count < chunk) break;
+    }
+    return original - len;
+}
+
+static int usb_character_write(usb_handle* h, const void* data, int len) {
+    const int count = adb_write(h->bulk_in.get(), data, len);
+    return count == len && !h->kicked ? count : -1;
+}
+
+static void usb_character_kick(usb_handle* h) {
+    h->kicked = true;
+    TEMP_FAILURE_RETRY(dup2(dummy_fd.get(), h->bulk_out.get()));
+    TEMP_FAILURE_RETRY(dup2(dummy_fd.get(), h->bulk_in.get()));
+}
+
+static void usb_character_open_thread(usb_handle* h) {
+    adb_thread_setname("usb character open");
+    for (;;) {
+        std::unique_lock<std::mutex> lock(h->lock);
+        h->notify.wait(lock, [h] { return h->open_new_connection; });
+        h->open_new_connection = false;
+        lock.unlock();
+        for (;;) {
+            h->bulk_out.reset(adb_open("/dev/android_adb", O_RDWR | O_CLOEXEC));
+            if (h->bulk_out.get() >= 0) break;
+            std::this_thread::sleep_for(1s);
+        }
+        h->bulk_in.reset(dup(h->bulk_out.get()));
+        if (h->bulk_in.get() < 0) LOG(FATAL) << "Cannot duplicate USB character device";
+        close_on_exec(h->bulk_in.get());
+        register_usb_transport(h, nullptr, nullptr, 1);
+    }
+}
+
 void usb_init_legacy() {
     D("[ usb_init - using legacy FunctionFS ]");
     dummy_fd.reset(adb_open("/dev/null", O_WRONLY | O_CLOEXEC));
     CHECK_NE(-1, dummy_fd.get());
 
+    if (access("/dev/android_adb", F_OK) == 0) {
+        auto* h = new usb_handle();
+        h->write = usb_character_write;
+        h->read = usb_character_read;
+        h->kick = usb_character_kick;
+        h->close = usb_ffs_close;
+        h->control.reset(adb_open("/dev/android_adb_enable", O_RDWR | O_CLOEXEC));
+        std::thread(usb_character_open_thread, h).detach();
+        return;
+    }
+
     std::thread(usb_legacy_ffs_open_thread, create_usb_handle(USB_FFS_NUM_BUFS, USB_FFS_BULK_SIZE))
             .detach();
 }
