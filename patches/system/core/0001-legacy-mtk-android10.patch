+#ifdef HEALTHD_BACKLIGHT_PATH
+static void set_backlight(bool on) {
+    const std::string value = std::to_string(on ? HEALTHD_BACKLIGHT_LEVEL : 0);
+    const int fd = open(HEALTHD_BACKLIGHT_PATH, O_WRONLY | O_CLOEXEC);
+    if (fd < 0) {
+        LOGE("Cannot open charger backlight: %s\n", strerror(errno));
+        return;
+    }
+    if (TEMP_FAILURE_RETRY(write(fd, value.data(), value.size())) !=
+            static_cast<ssize_t>(value.size())) {
+        LOGE("Cannot set charger backlight: %s\n", strerror(errno));
+    }
+    close(fd);
+}
+#endif
+
 void HealthdDraw::blank_screen(bool blank) {
     if (!graphics_available) return;
+#ifdef HEALTHD_BACKLIGHT_PATH
+    if (blank) set_backlight(false);
+#endif
     gr_fb_blank(blank);
+#ifdef HEALTHD_BACKLIGHT_PATH
