---
 .../com_android_server_location_GnssLocationProvider.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/services/core/jni/com_android_server_location_GnssLocationProvider.cpp b/services/core/jni/com_android_server_location_GnssLocationProvider.cpp
index 4fb2ae36..31e71699 100644
--- a/services/core/jni/com_android_server_location_GnssLocationProvider.cpp
+++ b/services/core/jni/com_android_server_location_GnssLocationProvider.cpp
@@ -1186,6 +1186,15 @@ static jboolean android_location_GnssLocationProvider_init(JNIEnv* env, jobject
         }
     }
 
+    if (agnssRilIface != nullptr) {
+        sp<IAGnssRilCallback> agnssRilCbIface = new AGnssRilCallback();
+        auto rilResult = agnssRilIface->setCallback(agnssRilCbIface);
+        if (!rilResult.isOk()) {
+            ALOGE("Unable to initialize AGnss RIL callbacks");
+            return JNI_FALSE;
+        }
+    }
+
     sp<IAGnssCallback> aGnssCbIface = new AGnssCallback();
     if (agnssIface != nullptr) {
         agnssIface->setCallback(aGnssCbIface);
