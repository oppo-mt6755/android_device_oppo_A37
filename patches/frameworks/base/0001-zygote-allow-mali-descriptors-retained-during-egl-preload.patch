From 0806a42187e5e2b842a346128f85622aa1dee3f0 Mon Sep 17 00:00:00 2001
From: affggh <879632264@qq.com>
Date: Fri, 20 Nov 2026 18:08:12 +0800
Subject: [PATCH] zygote: Allow Mali descriptors retained during EGL preload

Change-Id: I7c60df1b70b9641d780e751a77eb10e7414cb1fe
---
 core/jni/fd_utils.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/core/jni/fd_utils.cpp b/core/jni/fd_utils.cpp
index 92a54267..5ae14cd7 100644
--- a/core/jni/fd_utils.cpp
+++ b/core/jni/fd_utils.cpp
@@ -41,6 +41,9 @@ static const char* kPathWhitelist[] = {
   "/system/framework/framework-res.apk",
   "/dev/urandom",
   "/dev/ion",
+  // MTK Mali keeps these descriptors open while zygote preloads EGL.
+  "/proc/ged",
+  "/dev/mali0",
   "/dev/dri/renderD129", // Fixes b/31172436
   "/system/framework/org.lineageos.platform-res.apk",
 };
