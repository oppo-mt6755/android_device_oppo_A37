diff --git a/Android.bp b/Android.bp
index abdcea7..ce70b40 100644
--- a/Android.bp
+++ b/Android.bp
@@ -18,7 +18,7 @@ cc_library_shared {
         "libutils",
     ],
     header_libs: [
-        "generated_kernel_headers",
+        "tinycompress_kernel_headers",
     ],
     product_variables: {
         lineage: {
@@ -46,3 +46,19 @@ cc_binary {
         "libtinycompress",
     ],
 }
+
+// Keep old-kernel sound UAPI without shadowing bionic's asm/linux headers.
+lineage_generator {
+    name: "tinycompress_kernel_includes",
+    cmd: "$(PATH_OVERRIDE_SOONG) $(KERNEL_MAKE_CMD) $(KERNEL_MAKE_FLAGS) -C $(TARGET_KERNEL_SOURCE) O=$(KERNEL_BUILD_OUT_PREFIX)$(genDir) ARCH=$(KERNEL_ARCH) $(KERNEL_CROSS_COMPILE) headers_install && mkdir -p $(genDir)/include/sound && cp $(genDir)/usr/include/sound/asound.h $(genDir)/usr/include/sound/compress_params.h $(genDir)/usr/include/sound/compress_offload.h $(genDir)/include/sound/",
+    export_include_dirs: ["include"],
+    dep_root: "$(TARGET_KERNEL_SOURCE)",
+    dep_files: ["Makefile", "include/**/*", "arch/$(KERNEL_ARCH)/include/**/*"],
+}
+
+cc_library_headers {
+    name: "tinycompress_kernel_headers",
+    generated_headers: ["tinycompress_kernel_includes"],
+    export_generated_headers: ["tinycompress_kernel_includes"],
+    vendor_available: true,
+}
