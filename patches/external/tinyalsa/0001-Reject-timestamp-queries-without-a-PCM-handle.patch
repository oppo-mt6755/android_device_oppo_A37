From 46b80f7f32294cc44427e2ef07e8f53c3e7ee674 Mon Sep 17 00:00:00 2001
From: affggh <879632264@qq.com>
Date: Sun, 22 Nov 2026 22:48:52 +0800
Subject: [PATCH] Reject timestamp queries without a PCM handle

A legacy audio HAL can request presentation position before its PCM stream is opened. Reject null handles and output pointers with EINVAL instead of dereferencing them. The regression was reproduced after a clean data install; host ASan/UBSan checks cover invalid arguments and unchanged outputs.

Change-Id: I34b216430f41103fec26b187f955a54a3711da57
---
 pcm.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/pcm.c b/pcm.c
index 120d182..f278c9d 100644
--- a/pcm.c
+++ b/pcm.c
@@ -454,6 +454,10 @@ int pcm_get_htimestamp(struct pcm *pcm, unsigned int *avail,
     int rc;
     snd_pcm_uframes_t hw_ptr;
 
+    /* Legacy callers may query presentation position before opening PCM. */
+    if (pcm == NULL || avail == NULL || tstamp == NULL)
+        return -EINVAL;
+
     if (!pcm_is_ready(pcm))
         return -1;
 
