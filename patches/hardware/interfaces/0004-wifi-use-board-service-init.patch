Subject: [PATCH] wifi: Allow a device-specific service init script

Change-Id: I6c07273ad01093a1bd04ce6dadeaf02c03688398
---
 wifi/1.1/default/Android.mk | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/wifi/1.1/default/Android.mk b/wifi/1.1/default/Android.mk
index 5758422..e132544 100644
--- a/wifi/1.1/default/Android.mk
+++ b/wifi/1.1/default/Android.mk
@@ -48,5 +48,7 @@ LOCAL_SHARED_LIBRARIES := \
     libutils \
     libwifi-hal \
     libwifi-system-iface
+ifneq ($(TARGET_USES_CUSTOM_WIFI_SERVICE_RC),true)
 LOCAL_INIT_RC := android.hardware.wifi@1.0-service.rc
+endif
 include $(BUILD_EXECUTABLE)
