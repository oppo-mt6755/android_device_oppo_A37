From f02c13c195843fb43a32b870fc08ca1cacbc6b0f Mon Sep 17 00:00:00 2001
From: affggh <879632264@qq.com>
Date: Sun, 22 Nov 2026 17:13:39 +0800
Subject: [PATCH] gnss: Terminate length-delimited legacy NMEA buffers

Change-Id: I88e4dfb175bbd786883cf942763257783dba25e7
---
 gnss/1.0/default/Gnss.cpp | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/gnss/1.0/default/Gnss.cpp b/gnss/1.0/default/Gnss.cpp
index cfcee24..44f358e 100644
--- a/gnss/1.0/default/Gnss.cpp
+++ b/gnss/1.0/default/Gnss.cpp
@@ -260,8 +260,13 @@ void Gnss::nmeaCb(GpsUtcTime timestamp, const char* nmea, int length) {
         return;
     }
 
-    android::hardware::hidl_string nmeaString;
-    nmeaString.setToExternal(nmea, length);
+    if (nmea == nullptr || length <= 0) {
+        ALOGE("%s: Invalid NMEA buffer", __func__);
+        return;
+    }
+
+    // The legacy callback supplies a byte count, not a terminated string.
+    android::hardware::hidl_string nmeaString(nmea, static_cast<size_t>(length));
     auto ret = sGnssCbIface->gnssNmeaCb(timestamp, nmeaString);
     if (!ret.isOk()) {
         ALOGE("%s: Unable to invoke callback", __func__);
-- 
2.43.0

