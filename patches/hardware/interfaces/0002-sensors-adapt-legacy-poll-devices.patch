From 9cd38bc5aabb76e558cffbb6e22e0a4cfff0ba57 Mon Sep 17 00:00:00 2001
From: affggh <879632264@qq.com>
Date: Sat, 21 Nov 2026 18:57:54 +0800
Subject: [PATCH] sensors: Adapt legacy 1.1 HALs without accessing newer
 callbacks

Normalize reporting flags through the platform legacy Sensor constructor, use setDelay when batching is absent, and guard newer flush/direct-report callbacks by the actual HAL version. Allow the device tree to supply its service init script.

Change-Id: I8b94da962a1b4b465595a1c8673141f3a79db6da
---
 sensors/1.0/default/Android.bp  |  1 +
 sensors/1.0/default/Android.mk  |  2 ++
 sensors/1.0/default/Sensors.cpp | 32 ++++++++++++++++++++++++++++----
 3 files changed, 31 insertions(+), 4 deletions(-)

diff --git a/sensors/1.0/default/Android.bp b/sensors/1.0/default/Android.bp
index 4bbafa6..01cac7b 100644
--- a/sensors/1.0/default/Android.bp
+++ b/sensors/1.0/default/Android.bp
@@ -8,6 +8,7 @@ cc_library_shared {
         "liblog",
         "libcutils",
         "libhardware",
+        "libsensor",
         "libbase",
         "libutils",
         "libhidlbase",
diff --git a/sensors/1.0/default/Android.mk b/sensors/1.0/default/Android.mk
index d114542..4b2f94d 100644
--- a/sensors/1.0/default/Android.mk
+++ b/sensors/1.0/default/Android.mk
@@ -4,7 +4,9 @@ include $(CLEAR_VARS)
 LOCAL_MODULE_RELATIVE_PATH := hw
 LOCAL_PROPRIETARY_MODULE := true
 LOCAL_MODULE := android.hardware.sensors@1.0-service
+ifneq ($(TARGET_USES_CUSTOM_SENSORS_SERVICE_RC),true)
 LOCAL_INIT_RC := android.hardware.sensors@1.0-service.rc
+endif
 LOCAL_SRC_FILES := \
         service.cpp \
 
diff --git a/sensors/1.0/default/Sensors.cpp b/sensors/1.0/default/Sensors.cpp
index 1100dd6..5495fd5 100644
--- a/sensors/1.0/default/Sensors.cpp
+++ b/sensors/1.0/default/Sensors.cpp
@@ -15,6 +15,7 @@
  */
 
 #include "Sensors.h"
+#include <sensor/Sensor.h>
 #include "convert.h"
 #include "multihal.h"
 
@@ -95,7 +96,9 @@ Sensors::Sensors()
 
     // Require all the old HAL APIs to be present except for injection, which
     // is considered optional.
-    CHECK_GE(getHalDeviceVersion(), SENSORS_DEVICE_API_VERSION_1_3);
+    // legacy MTK uses the legacy 1.1 device. Optional operations below must not read
+    // callbacks appended by newer HAL versions.
+    CHECK_GE(getHalDeviceVersion(), SENSORS_DEVICE_API_VERSION_1_1);
 
     if (getHalDeviceVersion() == SENSORS_DEVICE_API_VERSION_1_4) {
         if (mSensorDevice->inject_sensor_data == nullptr) {
@@ -125,6 +128,15 @@ Return<void> Sensors::getSensorsList(getSensorsList_cb _hidl_cb) {
         SensorInfo *dst = &out[i];
 
         convertFromSensor(*src, dst);
+        if (getHalDeviceVersion() < SENSORS_DEVICE_API_VERSION_1_3) {
+            // HIDL otherwise makes SensorService treat this as a modern HAL.
+            // Preserve the platform's legacy reporting-mode and wake-up rules.
+            const ::android::Sensor normalized(src, getHalDeviceVersion());
+            dst->flags = normalized.getFlags();
+            dst->maxDelay = normalized.getMaxDelay();
+            dst->typeAsString = normalized.getStringType().c_str();
+            dst->requiredPermission = normalized.getRequiredPermission().c_str();
+        }
     }
 
     _hidl_cb(out);
@@ -235,6 +247,13 @@ Return<Result> Sensors::batch(
         int32_t sensor_handle,
         int64_t sampling_period_ns,
         int64_t max_report_latency_ns) {
+    if (mSensorDevice->batch == nullptr) {
+        if (max_report_latency_ns != 0 || mSensorDevice->setDelay == nullptr)
+            return Result::INVALID_OPERATION;
+        return ResultFromStatus(mSensorDevice->setDelay(
+                reinterpret_cast<sensors_poll_device_t*>(mSensorDevice),
+                sensor_handle, sampling_period_ns));
+    }
     return ResultFromStatus(
             mSensorDevice->batch(
                 mSensorDevice,
@@ -245,6 +264,8 @@ Return<Result> Sensors::batch(
 }
 
 Return<Result> Sensors::flush(int32_t sensor_handle) {
+    if (getHalDeviceVersion() < SENSORS_DEVICE_API_VERSION_1_2 ||
+            mSensorDevice->flush == nullptr) return Result::INVALID_OPERATION;
     return ResultFromStatus(mSensorDevice->flush(mSensorDevice, sensor_handle));
 }
 
@@ -263,7 +284,8 @@ Return<Result> Sensors::injectSensorData(const Event& event) {
 
 Return<void> Sensors::registerDirectChannel(
         const SharedMemInfo& mem, registerDirectChannel_cb _hidl_cb) {
-    if (mSensorDevice->register_direct_channel == nullptr
+    if (getHalDeviceVersion() < SENSORS_DEVICE_API_VERSION_1_4
+            || mSensorDevice->register_direct_channel == nullptr
             || mSensorDevice->config_direct_report == nullptr) {
         // HAL does not support
         _hidl_cb(Result::INVALID_OPERATION, -1);
@@ -288,7 +310,8 @@ Return<void> Sensors::registerDirectChannel(
 }
 
 Return<Result> Sensors::unregisterDirectChannel(int32_t channelHandle) {
-    if (mSensorDevice->register_direct_channel == nullptr
+    if (getHalDeviceVersion() < SENSORS_DEVICE_API_VERSION_1_4
+            || mSensorDevice->register_direct_channel == nullptr
             || mSensorDevice->config_direct_report == nullptr) {
         // HAL does not support
         return Result::INVALID_OPERATION;
@@ -302,7 +325,8 @@ Return<Result> Sensors::unregisterDirectChannel(int32_t channelHandle) {
 Return<void> Sensors::configDirectReport(
         int32_t sensorHandle, int32_t channelHandle, RateLevel rate,
         configDirectReport_cb _hidl_cb) {
-    if (mSensorDevice->register_direct_channel == nullptr
+    if (getHalDeviceVersion() < SENSORS_DEVICE_API_VERSION_1_4
+            || mSensorDevice->register_direct_channel == nullptr
             || mSensorDevice->config_direct_report == nullptr) {
         // HAL does not support
         _hidl_cb(Result::INVALID_OPERATION, -1);
-- 
2.43.0

