From 38d7cc829313df3345d61f56a3445f5fad105a39 Mon Sep 17 00:00:00 2001
From: affggh <879632264@qq.com>
Date: Sat, 21 Nov 2026 18:57:54 +0800
Subject: [PATCH] bluetooth: Keep complete H4 packets on character transports

The retained STP character driver has one write operation and splits writev segments into separate packets. Submit type and payload in one write; retain writev for other transports. Allow a device-provided service init script.

Change-Id: I70de26c394d9b1e08a10cd2419ab71af7d4371e7
---
 bluetooth/1.0/default/Android.mk     |  2 ++
 bluetooth/1.0/default/h4_protocol.cc | 17 ++++++++++++++++-
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/bluetooth/1.0/default/Android.mk b/bluetooth/1.0/default/Android.mk
index 38294c7..e2b4f83 100644
--- a/bluetooth/1.0/default/Android.mk
+++ b/bluetooth/1.0/default/Android.mk
@@ -19,7 +19,9 @@ include $(CLEAR_VARS)
 LOCAL_MODULE_RELATIVE_PATH := hw
 LOCAL_PROPRIETARY_MODULE := true
 LOCAL_MODULE := android.hardware.bluetooth@1.0-service
+ifneq ($(TARGET_USES_CUSTOM_BLUETOOTH_SERVICE_RC),true)
 LOCAL_INIT_RC := android.hardware.bluetooth@1.0-service.rc
+endif
 LOCAL_SRC_FILES := \
   service.cpp
 
diff --git a/bluetooth/1.0/default/h4_protocol.cc b/bluetooth/1.0/default/h4_protocol.cc
index 163cc33..efc296c 100644
--- a/bluetooth/1.0/default/h4_protocol.cc
+++ b/bluetooth/1.0/default/h4_protocol.cc
@@ -21,8 +21,10 @@
 #include <errno.h>
 #include <fcntl.h>
 #include <log/log.h>
+#include <sys/stat.h>
 #include <sys/uio.h>
 #include <unistd.h>
+#include <vector>
 
 namespace android {
 namespace hardware {
@@ -32,9 +34,22 @@ namespace hci {
 size_t H4Protocol::Send(uint8_t type, const uint8_t* data, size_t length) {
   struct iovec iov[] = {{&type, sizeof(type)},
                         {const_cast<uint8_t*>(data), length}};
+  struct stat status;
+  const bool character_device = fstat(uart_fd_, &status) == 0 && S_ISCHR(status.st_mode);
+  std::vector<uint8_t> packet;
+  if (character_device) {
+    // Legacy MTK stpbt has a .write operation, without a vectored-write
+    // operation. writev() submits the type and payload as separate STP packets;
+    // the controller expects the complete H4 packet in a single write.
+    packet.reserve(length + 1);
+    packet.push_back(type);
+    packet.insert(packet.end(), data, data + length);
+  }
   ssize_t ret = 0;
   do {
-    ret = TEMP_FAILURE_RETRY(writev(uart_fd_, iov, sizeof(iov) / sizeof(iov[0])));
+    ret = character_device
+        ? TEMP_FAILURE_RETRY(write(uart_fd_, packet.data(), packet.size()))
+        : TEMP_FAILURE_RETRY(writev(uart_fd_, iov, sizeof(iov) / sizeof(iov[0])));
   } while (-1 == ret && EAGAIN == errno);
 
   if (ret == -1) {
-- 
