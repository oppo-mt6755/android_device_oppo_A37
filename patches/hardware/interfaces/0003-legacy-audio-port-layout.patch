@@ -39,6 +39,42 @@ namespace implementation {
 
 using ::android::hardware::audio::common::CPP_VERSION::implementation::HidlUtils;
 
+#if defined(LEGACY_AUDIO_HAL) && !defined(AUDIO_NO_SYSTEM_DECLARATIONS)
+namespace {
+// Pre-P HALs have no framework-only flags word before the port extension.
+struct LegacyAudioPortConfig {
+    uint8_t common[offsetof(audio_port_config, flags)];
+    decltype(audio_port_config::ext) ext;
+};
+
+struct LegacyAudioPort {
+    uint8_t common[offsetof(audio_port, active_config)];
+    LegacyAudioPortConfig activeConfig;
+    decltype(audio_port::ext) ext;
+};
+
+static_assert(sizeof(LegacyAudioPortConfig) + sizeof(audio_io_flags) ==
+              sizeof(audio_port_config), "Unexpected legacy port layout");
+static_assert(sizeof(LegacyAudioPort) + sizeof(audio_io_flags) == sizeof(audio_port),
+              "Unexpected legacy audio port layout");
+
+LegacyAudioPortConfig legacyPortConfig(const audio_port_config& config) {
+    LegacyAudioPortConfig legacy{};
+    memcpy(legacy.common, &config, sizeof(legacy.common));
+    legacy.ext = config.ext;
+    return legacy;
+}
+
+std::vector<LegacyAudioPortConfig> legacyPortConfigs(const audio_port_config* configs,
+                                                   size_t count) {
+    std::vector<LegacyAudioPortConfig> legacy;
+    legacy.reserve(count);
+    for (size_t i = 0; i < count; ++i) legacy.push_back(legacyPortConfig(configs[i]));
+    return legacy;
+}
+}  // namespace
+#endif
+
 Device::Device(audio_hw_device_t* device) : mDevice(device) {}
 
 Device::~Device() {
