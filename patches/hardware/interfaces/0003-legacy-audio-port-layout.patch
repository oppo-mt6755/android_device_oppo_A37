         audio_patch_handle_t halPatch = AUDIO_PATCH_HANDLE_NONE;
+#if defined(LEGACY_AUDIO_HAL) && !defined(AUDIO_NO_SYSTEM_DECLARATIONS)
+        auto legacySources = legacyPortConfigs(halSources.get(), sources.size());
+        auto legacySinks = legacyPortConfigs(halSinks.get(), sinks.size());
+        retval = analyzeStatus("create_audio_patch",
