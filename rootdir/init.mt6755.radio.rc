# Modem initialization follows the NVRAM setup in post-fs-data.
on post-fs-data
    setprop ril.current.share_modem 2
    mkdir /dev/radio 0770 radio radio
    mkdir /data/ccci_cfg 0770 radio radio
    mkdir /data/mdlog 0770 radio radio
    chown radio radio /sys/kernel/ccci/boot
    chmod 0660 /sys/kernel/ccci/boot

service ccci_fsd /vendor/bin/ccci_fsd 0
    user radio
    group radio system
    class main
    oneshot

service ccci_mdinit /vendor/bin/ccci_mdinit 0
    user system
    group radio system
    class main
    oneshot

service gsm0710muxd /vendor/bin/gsm0710muxd -s /dev/ttyC0 -f 512 -n 8 -m basic
    class core
    user root
    group radio cache inet misc
    disabled
    oneshot

service muxreport-daemon /vendor/bin/muxreport
    class core
    user radio
    group radio cache inet misc
    disabled
    oneshot

on property:ril.muxreport=1
    start muxreport-daemon

service ril-daemon-mtk /vendor/bin/hw/rild
    class main
    # The daemon drops to radio itself while retaining its network capabilities.
    user root
    group radio cache inet misc audio log readproc wakelock system
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    disabled

on property:ril.mtk=1
    start ril-daemon-mtk
