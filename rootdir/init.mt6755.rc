import /init.mt6755.usb.rc

on init
    mkdir /protect_f 0771 system system
    mkdir /protect_s 0771 system system
    mkdir /nvdata 0771 system system

on fs
    mount_all /fstab.mt6755

on post-fs
    # BatteryStats and the graphics memory HAL read debugfs on this kernel.
    mount debugfs debugfs /sys/kernel/debug
    # The stock hotplug driver leaves empty child cpusets on Oreo.
    write /proc/hps/enabled 0
    write /sys/devices/system/cpu/cpu0/online 1
    write /sys/devices/system/cpu/cpu1/online 1
    write /sys/devices/system/cpu/cpu2/online 1
    write /sys/devices/system/cpu/cpu3/online 1
    write /sys/devices/system/cpu/cpu4/online 1
    write /sys/devices/system/cpu/cpu5/online 1
    write /sys/devices/system/cpu/cpu6/online 1
    write /sys/devices/system/cpu/cpu7/online 1
    write /dev/cpuset/foreground/cpus 0-7
    write /dev/cpuset/foreground/mems 0
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/background/mems 0
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/system-background/mems 0
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/top-app/mems 0

on post-fs-data
    # Nodes used by the Sony graphics HALs with the existing OPPO kernel.
    chown system graphics /dev/mali0
    chmod 0666 /dev/mali0
    chown system graphics /dev/ion
    chmod 0666 /dev/ion
    chown system graphics /dev/mtk_disp_mgr
    chmod 0660 /dev/mtk_disp_mgr
    chown system graphics /dev/mtk_disp
    chmod 0660 /dev/mtk_disp
    chown system graphics /dev/mtk_cmdq
    chmod 0660 /dev/mtk_cmdq
    chown system graphics /dev/m4u
    chmod 0660 /dev/m4u
    chown system graphics /dev/ged
    chmod 0660 /dev/ged
    setrlimit 8 -1 -1

on boot
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0664 /sys/class/leds/lcd-backlight/brightness

service charger /charger
    class charger
    seclabel u:r:charger:s0

# Sony lights.mt6755 uses this service for the standard backlight sysfs node.
service led_service /system/bin/led_service
    socket led_socket stream 0660 system system
    class core
    user root
    group system graphics
