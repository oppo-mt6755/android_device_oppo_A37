# /system is mounted by first-stage init using the kernel DT fstab.
# A37 measured partition map. Recovery/OTA paths must also work with the old ported TWRP.
# Android fstab file.
#<src>           <mnt_point>         <type>    <mnt_flags and options>                 <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

/dev/block/mmcblk0p32   /data        ext4   noatime,nosuid,nodev,noauto_da_alloc,discard               wait,check,encryptable=/dev/block/mmcblk0p11
/dev/block/mmcblk0p31      /cache       ext4   noatime,nosuid,nodev,noauto_da_alloc,discard               wait,check
/dev/block/mmcblk0p12   /protect_f   ext4   noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc   wait,check
/dev/block/mmcblk0p13   /protect_s   ext4   noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc   wait,check
/dev/block/mmcblk0p10     /nvdata      ext4   noatime,nosuid,nodev,noauto_da_alloc,discard               wait,check
/dev/block/mmcblk0p9          /persistent         emmc       defaults                                                      defaults

/devices/mtk-msdc.0/11240000.msdc1*                                auto                vfat       defaults                                                      voldmanaged=sdcard1:auto,encryptable=userdata
/devices/mtk-usbotg.1/11270000.usb3_xhci*                                   auto                vfat       defaults                                                      voldmanaged=usbotg:auto
/dev/block/mmcblk0p21        /nvram              emmc       defaults                                                      defaults
/dev/block/mmcblk0p16      /proinfo            emmc       defaults                                                      defaults
/dev/block/mmcblk0p22           /bootloader         emmc       defaults                                                      defaults
/dev/block/mmcblk0p2         /misc               emmc       defaults                                                      defaults
/dev/block/mmcblk0p24          /boot           emmc  defaults defaults
/dev/block/mmcblk0p1      /recovery       emmc  defaults defaults
/dev/block/mmcblk0p25         /logo               emmc       defaults                                                      defaults
/dev/block/mmcblk0p8        /expdb              emmc       defaults                                                      defaults
/dev/block/mmcblk0p28        /secro              emmc       defaults                                                      defaults
/dev/block/mmcblk0p14       /seccfg             emmc       defaults                                                      defaults
/dev/block/mmcblk0p17       /md1img             emmc       defaults                                                      defaults
/dev/block/mmcblk0p26         /tee1               emmc       defaults                                                      defaults
/dev/block/mmcblk0p27         /tee2               emmc       defaults                                                      defaults

# Compressed RAM swap; configured once by swapon_all after /system is available.
/dev/block/zram0 none swap defaults zramsize=536870912,max_comp_streams=8,swapprio=32758
